#!/bin/bash

echo "building linux platform"
gcc -g -c -o linux.o linux.c
ar rcs libplatlinux.a linux.o
rm linux.o

echo "building graphics"
DEF="-DDEBUG"
INC="-I$VULKAN_SDK/include"
LIB="-L$VULKAN_SDK/lib -lvolk -lglfw"
gcc -g -c $DEF $INC $LIB -o graphics.o graphics_impl.c
ar rcs libgraphics.a graphics.o
rm graphics.o

echo "building final executable"
gcc -g test.c -lglfw -L. -lplatlinux -lgraphics 